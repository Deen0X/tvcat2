{
  "name": "tvcat_player_hls_seq",
  "version": "1.0.0",
  "type": "player",
  "displayName": "Player HLS SEQ",
  "description": "Reproductor basado en HLS nativo para SmartTVs antiguas (Tizen 2.4 / WebKit 538.1). Resuelve el seek en dispositivos que no soportan Range requests progresivos. Requiere que el servidor tenga ffmpeg instalado.",
  "icon": "static/plugin_icon.png",
  "iconEmoji": "\u00c1\u00b0\u00c5\u00b8\u00e2\u20ac\u0153\u00a1",
  "defaultEnabled": true,
  "action_category": "playback",
  "single_button": true,
  "priority": 3,
  "js": [
    "hls.min.js?v=20260935z21",
    "player_hls.js?v=20260935"
  ],
  "css": [],
  "applies_to": [
    "media",
    "series",
    "video"
  ],
  "settings_schema": [
