      "id": "force_hls",
      "label": "Forzar HLS en todos los dispositivos",
      "type": "checkbox",
      "default": false,
      "description": "Activa este reproductor en todos los dispositivos, no solo en SmartTVs antiguas. Util para pruebas."
    },
    {
