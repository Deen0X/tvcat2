# TVCat2 — .gitignore para proyecto tvcat2 (público)
# Ignora bases de datos activas, conserva plantillas _default.db
*.db
!*_default.db
**/*.db
!**/*_default.db
*.db-journal
*.db-wal
*.db-shm

# Backups locales — nunca versionar
*.backup
*.backup*
**/*.backup
**/*.backup*
*.bak
**/*.bak

# Caches y temporales
__pycache__/
*.py[cod]
.venv/
venv/
*.log
logs/
cache/
data/
hls_segments/
hls_seq_segments/
hls_subs/
tmp/
temp/
# Restos de descargas Telethon (stripped/cached) + estados runtime
photo_*.jpg
**/photo_*.jpg
**/state.json
plugins_order.json
**/plugins_order.json
*.backup_20*
**/*.backup_20*

# Config y sesiones locales
config/
*.session
*.session-journal
.env

# Binarios externos
ffmpeg/
tools/ffmpeg/
*.exe
*.dll

# IDEs
.vs/
.vscode/
.idea/

# Archivos y carpetas a ignorar (solicitud usuario)
_cmp_3ds_err.txt
_cmp_3ds_out.txt
**/_cmp_3ds_err.txt
**/_cmp_3ds_out.txt
backup/
**/backup/
tools/companion_pc.js
**/tools/companion_pc.js
tools/companion_3ds/
**/tools/companion_3ds/
tvcat/plugins/tvcat_installer_3ds/
**/tvcat_installer_3ds/
tvcat/plugins/tvcat_peers/
**/tvcat_peers/
tvcat_installer_3ds/
tvcat_peers/
tvcat/plugins/tvcat_TGHirayi/data/TGHirayi.json
**/TGHirayi.json
